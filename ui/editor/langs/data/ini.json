{
	"registrationOrder": 32,
	"registration": {
		"id": "ini",
		"extensions": [
			".ini",
			".properties",
			".gitconfig"
		],
		"filenames": [
			"config",
			".gitattributes",
			".gitconfig",
			".editorconfig"
		],
		"filenamePatterns": [],
		"aliases": [
			"Ini",
			"ini"
		],
		"mimetypes": [],
		"firstLine": ""
	},
	"language": {
		"defaultToken": "",
		"tokenPostfix": ".ini",
		"escapes": {
			"$regex": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
			"flags": ""
		},
		"tokenizer": {
			"root": [
				[
					{
						"$regex": "^\\[[^\\]]*\\]",
						"flags": ""
					},
					"metatag"
				],
				[
					{
						"$regex": "(^\\w+)(\\s*)(\\=)",
						"flags": ""
					},
					[
						"key",
						"",
						"delimiter"
					]
				],
				{
					"include": "@whitespace"
				},
				[
					{
						"$regex": "\\d+",
						"flags": ""
					},
					"number"
				],
				[
					{
						"$regex": "\"([^\"\\\\]|\\\\.)*$",
						"flags": ""
					},
					"string.invalid"
				],
				[
					{
						"$regex": "'([^'\\\\]|\\\\.)*$",
						"flags": ""
					},
					"string.invalid"
				],
				[
					{
						"$regex": "\"",
						"flags": ""
					},
					"string",
					"@string.\""
				],
				[
					{
						"$regex": "'",
						"flags": ""
					},
					"string",
					"@string.'"
				]
			],
			"whitespace": [
				[
					{
						"$regex": "[ \\t\\r\\n]+",
						"flags": ""
					},
					""
				],
				[
					{
						"$regex": "^\\s*[#;].*$",
						"flags": ""
					},
					"comment"
				]
			],
			"string": [
				[
					{
						"$regex": "[^\\\\\"']+",
						"flags": ""
					},
					"string"
				],
				[
					{
						"$regex": "@escapes",
						"flags": ""
					},
					"string.escape"
				],
				[
					{
						"$regex": "\\\\.",
						"flags": ""
					},
					"string.escape.invalid"
				],
				[
					{
						"$regex": "[\"']",
						"flags": ""
					},
					{
						"cases": {
							"$#==$S2": {
								"token": "string",
								"next": "@pop"
							},
							"@default": "string"
						}
					}
				]
			]
		}
	},
	"conf": {
		"comments": {
			"lineComment": "#"
		},
		"brackets": [
			[
				"{",
				"}"
			],
			[
				"[",
				"]"
			],
			[
				"(",
				")"
			]
		],
		"autoClosingPairs": [
			{
				"open": "{",
				"close": "}"
			},
			{
				"open": "[",
				"close": "]"
			},
			{
				"open": "(",
				"close": ")"
			},
			{
				"open": "\"",
				"close": "\""
			},
			{
				"open": "'",
				"close": "'"
			}
		],
		"surroundingPairs": [
			{
				"open": "{",
				"close": "}"
			},
			{
				"open": "[",
				"close": "]"
			},
			{
				"open": "(",
				"close": ")"
			},
			{
				"open": "\"",
				"close": "\""
			},
			{
				"open": "'",
				"close": "'"
			}
		]
	}
}
