# Files the tests compare byte for byte with what the code produces. Windows
# checkouts with core.autocrlf=true (the Git for Windows default, and
# GitHub's Windows runners) would turn them CRLF and fail the comparison, or
# for golden_fonts.txt silently skip the golden image tests, so keep them LF
# everywhere.
internal/render/shader/*/testdata/** text eol=lf
internal/render/gpu/gen/** text eol=lf
ui/testdata/*.txt text eol=lf
ui/editor/testdata/*.txt text eol=lf
# API snapshots and contracts, compared with what the code exports and parsed
# line by line (jsapi's TestWireContract, internal/cmd/apitxt).
api/** text eol=lf
# tan's CLI golden and tan.json schema (cmd/tan TestCLIGolden, TestConfigSchema).
cmd/tan/testdata/** text eol=lf
cmd/tan/tan.schema.json text eol=lf
