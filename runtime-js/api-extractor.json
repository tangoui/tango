{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "bundledPackages": [],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "runtime",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/dist/api-extractor/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "newlineKind": "lf",
  "messages": {
    "compilerMessageReporting": { "default": { "logLevel": "error" } },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning", "addToApiReportFile": true },
      "ae-missing-release-tag": { "logLevel": "none", "addToApiReportFile": false }
    },
    "tsdocMessageReporting": { "default": { "logLevel": "none" } }
  }
}
