const sysMobile = [
  ["permission", "运行时权限"], ["share", "分享"], ["haptics", "触感反馈"], ["safearea", "安全区"],
  ["orientation", "屏幕方向"], ["biometric", "生物识别"], ["securestore", "安全存储"],
  ["media", "相册与拍照"], ["location", "定位"], ["push", "远程推送"],
];
const sysItems = (list: string[][]) =>
  list
    .filter(([n]) => fs.existsSync(path.join(here, "..", "guide", "system", `${n}.md`)))
    .map(([n, t]) => ({ text: `${n} · ${t}`, link: `/guide/system/${n}` }));

// API reference pages are generated by tools/apigen (npm run docs:api).
function apiItems(): DefaultTheme.SidebarItem[] {
  const dir = path.join(here, "..", "reference", "api");
  if (!fs.existsSync(dir)) return [];
  const pages = fs.readdirSync(dir).filter((f) => f.endsWith(".md") && f !== "index.md").map((f) => f.slice(0, -3));
  const groups: Record<string, string[]> = { 核心: [], "sys/": [], "service/": [], "ui/": [] };
  for (const p of pages.sort()) {
    if (p.startsWith("sys-")) groups["sys/"].push(p);
    else if (p.startsWith("service")) groups["service/"].push(p);
    else if (p === "ui" || p.startsWith("ui-") || p === "uihost") groups["ui/"].push(p);
    else groups["核心"].push(p);
  }
  return Object.entries(groups)
    .filter(([, ps]) => ps.length)
    .map(([g, ps]) => ({
      text: g,
      collapsed: g !== "核心",
      items: ps.map((p) => ({ text: p === "tango" ? "tango（根包）" : p.replace(/-/g, "/"), link: `/reference/api/${p}` })),
    }));
}

function componentSidebar(): DefaultTheme.SidebarItem[] {
  const file=path.join(here,"generated/components.json");
  if (!fs.existsSync(file)) return [{text:"GUI 组件",items:[{text:"完整在线目录",link:"/components/"}]}];
  const catalog=JSON.parse(fs.readFileSync(file,"utf8"));
  return [
    {text:"GUI 组件",items:[{text:"全部组件与场景",link:"/components/"},{text:"代码编辑器在线演示",link:"/components/code-editor"},{text:"静态截图目录",link:"/guide/components"}]},
    ...catalog.groups.map((group: string)=>({
      text:group,collapsed:true,
      items:catalog.components.filter((entry: {group:string})=>entry.group===group)
        .map((entry: {names:string[];slug:string})=>({text:entry.names.slice(0,2).join(" · "),link:`/components/catalog/${entry.slug}`})),
    })),
  ];
}

