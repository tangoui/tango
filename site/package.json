{
  "name": "tango-docs",
  "private": true,
  "type": "module",
  "description": "Tango documentation site (VitePress)",
  "scripts": {
    "docs:api": "cd .. && go run ./site/tools/apigen -root . -out site/reference/api",
    "docs:cli": "node tools/clidoc.mjs",
    "docs:gallery": "node tools/gallery.mjs",
    "docs:gen": "npm run docs:api && npm run docs:cli && npm run docs:playground && npm run docs:gallery",
    "docs:dev": "npm run docs:gen && vitepress dev",
    "docs:build": "npm run docs:gen && vitepress build",
    "docs:preview": "vitepress preview",
    "docs:links": "node tools/checklinks.mjs",
    "docs:playground": "node tools/build-playground.mjs",
    "docs:test": "npm run docs:playground && node --test tools/playground/*.test.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
