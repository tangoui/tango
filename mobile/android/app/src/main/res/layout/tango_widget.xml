<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (org.tango.host.TangoWidget). RemoteViews layouts
     may only use a fixed set of framework views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tango_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/tango_widget_background">

    <TextView
        android:id="@+id/tango_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FF1C1C1E"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tango_widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="#FF3A3A3C"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
